DATABASE_PATH=./field_to_record.sqlite3
WHISPER_MODEL_PATH=../models/whisper-tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WARM_SPEECH=1
PARTIAL_INTERVAL_MS=600
ENDPOINT_SILENCE_MS=700
MAX_SPEECH_SESSIONS=4
MAX_AUDIO_MB=25
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional server deployment: DB_DSN=postgresql://user:password@localhost:5432/field

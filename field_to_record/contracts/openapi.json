  "components": {
    "schemas": {
      "Body_transcribe_api_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcribe_api_transcribe_post"
      },
      "ClinicalEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "medication_administration",
              "procedure",
              "observation",
              "unclassified"
            ],
            "title": "Event Type"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description"
          },
          "medication": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Medication"
          },
          "dose": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Dose"
              },
              {
                "type": "null"
              }
            ]
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "observation": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation"
          },
          "event_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Time"
          },
          "time_source": {
            "type": "string",
            "enum": [
              "reported",
              "relative",
              "unknown"
            ],
            "title": "Time Source",
            "default": "unknown"
          },
          "action_status": {
            "type": "string",
            "enum": [
              "completed",
              "not_done",
              "unclear"
            ],
            "title": "Action Status",
            "default": "unclear"
          },
          "status": {
            "type": "string",
            "enum": [
              "reported",
              "negated",
              "uncertain",
              "needs_review"
            ],
            "title": "Status",
            "default": "needs_review"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          },
          "source_offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Source Offset",
            "default": 0
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "object",
            "title": "Fields"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "needs_human_confirmation",
              "confirmed",
              "corrected"
            ],
            "title": "Review Status",
            "default": "needs_human_confirmation"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          },
          "accepted_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Flags"
          },
          "manual": {
            "type": "boolean",
            "title": "Manual",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "description",
          "source_text"
        ],
        "title": "ClinicalEvent"
      },
      "Dose": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Dose"
      },
      "Evidence": {
        "properties": {
          "value": {
            "title": "Value"
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "corrected",
              "missing",
              "needs_review"
            ],
            "title": "Status",
            "default": "missing"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Evidence"
      },
      "ExtractRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "case_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Case Id",
            "default": "DEMO-001"
          },
          "responder_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Responder Id",
            "default": "DEMO-RESPONDER"
          },
          "encounter_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encounter Date"
          },
          "tz": {
            "type": "string",
            "title": "Tz",
            "default": "Asia/Kolkata"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Words"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ExtractRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SaveRecordRequest": {
        "properties": {
          "case_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Case Id"
          },
          "responder_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Responder Id"
          },
          "narrative": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Narrative"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/ClinicalEvent"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Events"
          },
          "extraction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Id"
          },
          "record_status": {
            "type": "string",
            "enum": [
              "pending_review",
              "reviewed"
            ],
            "title": "Record Status",
            "default": "pending_review"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          },
          "encounter_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encounter Date"
          },
          "tz": {
            "type": "string",
            "title": "Tz",
            "default": "Asia/Kolkata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "responder_id",
          "narrative",
          "events"
        ],
        "title": "SaveRecordRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Word": {
        "properties": {
          "w": {
            "type": "string",
            "title": "W"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0.0,
            "title": "End"
          },
          "prob": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Prob"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "w",
          "start",
          "end",
          "prob"
        ],
        "title": "Word"
      }
    }
  }
